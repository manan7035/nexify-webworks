# ==============================================================================
# Nexify Webworks - Production Environment Configuration Template
# Copy these key-value pairs into your hosting environment (Vercel / Netlify / cPanel)
# ==============================================================================

# Resend Email API Key (Get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_actual_resend_api_key_here

# Verified Sender Email (Must match domain verified in Resend Dashboard: https://resend.com/domains)
RESEND_FROM_EMAIL="Nexify Webworks <info@nexifywebworks.in>"

# Admin Recipient Email for Contact Submissions
CONTACT_EMAIL=info@nexifywebworks.in

# Google Gemini API Key (Optional for automated AI inquiry acknowledgment)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
