# GEMINI_API_KEY: Required for the server-side Gemini AI API calls made by
# POST /api/gemini. The key is read only in the Next.js API route (never sent
# to or stored in the browser). Obtain one from Google AI Studio.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: (Optional) Gemini model to use for the contact form endpoint.
# Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL="gemini-2.5-flash"

# RESEND_API_KEY: Required for the contact form delivery email.
# Obtain one from https://resend.com and keep it secret.
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# RESEND_FROM_EMAIL: Optional verified sender address for Resend.
# This should be a verified sender on your Resend account.
RESEND_FROM_EMAIL="info@nexifywebworks.in"

# CONTACT_EMAIL: The address that receives contact form submissions.
CONTACT_EMAIL="info@nexifywebworks.in"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
